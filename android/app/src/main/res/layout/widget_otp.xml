<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Alamat & OTP" (RemoteViews: hanya view yang didukung). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TempMail"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/widget_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/w_otp_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_otp_bg"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">
        <TextView
            android:id="@+id/w_otp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:singleLine="true"
            android:textColor="@color/widget_text"
            android:textSize="24sp"
            android:textStyle="bold" />
        <!-- Dipakai bila item terakhir berupa link (OTP disembunyikan). -->
        <TextView
            android:id="@+id/w_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/widget_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/w_otp_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/w_copy_addr"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Alamat"
            android:drawableStart="@drawable/ic_w_copy"
            android:drawablePadding="4dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textAllCaps="false"
            android:textColor="@color/widget_btn_text"
            android:textSize="12sp" />
        <Button
            android:id="@+id/w_copy_otp"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="OTP"
            android:drawableStart="@drawable/ic_w_copy"
            android:drawablePadding="4dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textAllCaps="false"
            android:textColor="@color/widget_btn_text"
            android:textSize="12sp" />
        <Button
            android:id="@+id/w_wait"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Tunggu"
            android:singleLine="true"
            android:ellipsize="end"
            android:textAllCaps="false"
            android:textColor="@color/widget_btn_text"
            android:textSize="12sp" />
        <ImageButton
            android:id="@+id/w_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn"
            android:contentDescription="Muat ulang OTP"
            android:src="@drawable/ic_w_refresh" />
    </LinearLayout>
</LinearLayout>
